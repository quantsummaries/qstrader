digraph "packages" {
rankdir=BT
charset="utf-8"
"qstrader.portcon" [color="black", label=<qstrader.portcon>, shape="box", style="solid"];
"qstrader.portcon.optimiser" [color="black", label=<qstrader.portcon.optimiser>, shape="box", style="solid"];
